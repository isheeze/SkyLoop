; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Skyloop"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.98, 0.78, 0.7, 1)
boot_splash/image="res://art/ui/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=432
window/size/window_height_override=970
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="mobile"
; The Android emulator cannot present Vulkan frames; its build uses OpenGL instead.
renderer/rendering_method.emulator="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[autoload]

Fx="*res://ui/fx.gd"
Net="*res://net/net.gd"

[skyloop]

; Production game server. Empty means the game runs its service inside the app.
server_url=""
